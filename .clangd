CompileFlags:
  Add:
    - -std=c17
    - -xc
    - -Wall
    - -Wextra
    - -Werror
    - -pedantic

---
If:
  PathMatch: .*\.h
CompileFlags:
  Add:
    - -xc-header
    - -Wno-unused-function

---
If:
  PathMatch: test/[^/]*\.c
CompileFlags:
  Add:
    - -Wno-unused-function

---
If:
  PathMatch: src/scanner\.c
CompileFlags:
  Add:
    - -Wno-unused-function

---
If:
  PathMatch: bindings/python/.*\.c
CompileFlags:
  Add:
    - -I../../src
